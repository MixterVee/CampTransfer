<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TurtleTransfer</AssemblyName>
    <RootNamespace>CampTransfer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\TurtleTransfer.ico</ApplicationIcon>
    <Product>Turtle Transfer</Product>
    <Title>Turtle Transfer</Title>
    <Description>Controlled file transfers at your pace.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="relay\**\*.cs" />
  </ItemGroup>
</Project>
